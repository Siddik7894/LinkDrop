# ── Database ──────────────────────────────────────────────────────────
# Local development uses prisma/schema.local.prisma (SQLite).
DATABASE_URL="file:./dev.db"
# On Vercel, set DATABASE_URL to your PostgreSQL connection string instead:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ── App URL ───────────────────────────────────────────────────────────
# Used to generate shareable drop links
# Vercel auto-sets VERCEL_URL, but explicit NEXT_PUBLIC_APP_URL takes priority
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── File Storage ──────────────────────────────────────────────────────
# Priority: Vercel Blob > S3/R2 > Local filesystem

# Vercel deployments require persistent storage for uploads.
# Attach a Blob store in the Vercel project Storage tab to create this token.
BLOB_READ_WRITE_TOKEN=""

# Option 2: Local dev — files saved to this directory
LOCAL_UPLOAD_DIR="./uploads"

# Option 3: S3-compatible (Cloudflare R2 / AWS S3 / MinIO)
# AWS_REGION="auto"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET="linkdrop-files"
# AWS_ENDPOINT=""  # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
