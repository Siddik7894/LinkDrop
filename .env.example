# ── Database ──────────────────────────────────────────────────────────
# Local dev (SQLite):   DATABASE_URL="file:./dev.db"
# Production (Neon):    DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL=""

# ── App URL ───────────────────────────────────────────────────────────
# Used to generate shareable drop links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── File Storage ──────────────────────────────────────────────────────
# Local dev — files saved to this directory (ignored in production)
LOCAL_UPLOAD_DIR="./uploads"

# Production — Cloudflare R2 / AWS S3 / MinIO (S3-compatible)
AWS_REGION="auto"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="linkdrop-files"
# R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ENDPOINT=""
